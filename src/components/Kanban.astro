                        data-bs-title="Editar"
                    >
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                    <button
                        type="button"
                        class="btn btn-sm btn-link p-0 text-danger"
                        data-action="excluir"
                        title="Excluir"
                        data-bs-toggle="tooltip"
                        data-bs-title="Excluir"
                    >
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section class="kanban-column" data-status="done">
        <div class="kanban-column-header">
            <span><i class="bi bi-check-circle text-success me-1"></i>Concluído</span>
            <span class="badge bg-secondary rounded-pill js-count">0</span>
        </div>

        <div class="kanban-list" data-status="done">
            <div class="kanban-card priority-media" data-priority="media" data-id="87" draggable="true">
                <div class="card-title">Migrar amCharts 3 para amCharts 5</div>
                <div class="card-meta">
                    <span><i class="bi bi-flag-fill text-warning"></i> Média</span>
                    <span>#087</span>
                </div>
                <div class="card-actions">
                    <button
                        type="button"
                        class="btn btn-sm btn-link p-0 me-2"
                        data-action="editar"
                        title="Editar"
                        data-bs-toggle="tooltip"
                        data-bs-title="Editar"
                    >
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                    <button
                        type="button"
                        class="btn btn-sm btn-link p-0 text-danger"
                        data-action="excluir"
                        title="Excluir"
                        data-bs-toggle="tooltip"
                        data-bs-title="Excluir"
                    >
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal Nova Tarefa -->
<Modal />

<script is:inline>
(function () {
    "use strict";

    var board = document.getElementById("kanbanBoard");
    var listas = board.querySelectorAll(".kanban-list");
    var colunas = board.querySelectorAll(".kanban-column");
    var contadorId = 200;
    var cardArrastado = null;
    var placeholder = document.createElement("div");
    placeholder.className = "drop-placeholder";

    var modalEl = document.getElementById("modalNovaTarefa");
    var modalTitulo = document.getElementById("modalNovaTarefaTitulo");
    var inputId = document.getElementById("inputIdTarefa");
    var inputTitulo = document.getElementById("inputTituloTarefa");
    var selectPrioridade = document.getElementById("selectPrioridadeTarefa");
    var selectColuna = document.getElementById("selectColunaTarefa");
    var btnSalvar = document.getElementById("btnSalvarTarefa");

    function atualizarContadores() {
        colunas.forEach(function (coluna) {
            var status = coluna.dataset.status;
            var lista = coluna.querySelector('.kanban-list[data-status="' + status + '"]');
            var qtd = lista.querySelectorAll(".kanban-card").length;
            coluna.querySelector(".js-count").textContent = qtd;
        });
    }

    function limparPlaceholder() {
        if (placeholder.parentNode) {
            placeholder.parentNode.removeChild(placeholder);
        }
    }

    var iconePrioridade = { alta: "text-danger", media: "text-warning", baixa: "text-success" };
    var labelPrioridade = { alta: "Alta", media: "Média", baixa: "Baixa" };

    function montarHtmlCard(titulo, prioridade, id) {
        return (
            '<div class="card-title"></div>' +
            '<div class="card-meta">' +
                '<span><i class="bi bi-flag-fill ' + iconePrioridade[prioridade] + '"></i> ' + labelPrioridade[prioridade] + "</span>" +
                "<span>#" + id + "</span>" +
            "</div>" +
            '<div class="card-actions">' +
                '<button type="button" class="btn btn-sm btn-link p-0 me-2" data-action="editar" title="Editar">' +
                    '<i class="bi bi-pencil-fill"></i>' +
                "</button>" +
                '<button type="button" class="btn btn-sm btn-link p-0 text-danger" data-action="excluir" title="Excluir">' +
                    '<i class="bi bi-trash-fill"></i>' +
                "</button>" +
            "</div>"
        );
    }

    function criarCardElemento(titulo, prioridade, id) {
        var card = document.createElement("div");
        card.className = "kanban-card priority-" + prioridade;
        card.dataset.priority = prioridade;
        card.dataset.id = id;
        card.draggable = true;

        card.innerHTML = montarHtmlCard(titulo, prioridade, id);
        card.querySelector(".card-title").textContent = titulo;

        ligarEventosCard(card);
        return card;
    }

    // --- Drag and drop (igual antes) ---
    function ligarEventosCard(card) {
        card.addEventListener("dragstart", function (e) {
            cardArrastado = card;
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", card.dataset.id || "");
            setTimeout(function () {
                card.classList.add("dragging");
            }, 0);
        });

        card.addEventListener("dragend", function () {
            card.classList.remove("dragging");
            limparPlaceholder();
            cardArrastado = null;
        });
    }

    board.querySelectorAll(".kanban-card").forEach(ligarEventosCard);

    listas.forEach(function (lista) {
        lista.addEventListener("dragover", function (e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";

            var coluna = lista.closest(".kanban-column");
            coluna.classList.add("drag-over");

            var elementoApos = elementoDepoisDoCursor(lista, e.clientY);

            if (elementoApos == null) {
                lista.appendChild(placeholder);
            } else {
                lista.insertBefore(placeholder, elementoApos);
            }
        });

        lista.addEventListener("dragleave", function (e) {
            if (!lista.contains(e.relatedTarget)) {
                lista.closest(".kanban-column").classList.remove("drag-over");
            }
        });

        lista.addEventListener("drop", function (e) {
            e.preventDefault();

            var coluna = lista.closest(".kanban-column");
            coluna.classList.remove("drag-over");

            if (cardArrastado) {
                lista.insertBefore(cardArrastado, placeholder);
                limparPlaceholder();

                var novoStatus = lista.dataset.status;
                cardArrastado.dataset.statusAtual = novoStatus;

                atualizarContadores();

                // fetch('/salvar-status-tarefa.asp', { method: 'POST', ... });
            }
        });
    });

    function elementoDepoisDoCursor(lista, y) {
        var cardsElegiveis = Array.prototype.slice.call(lista.querySelectorAll(".kanban-card:not(.dragging)"));

        return cardsElegiveis.reduce(
            function (maisProximo, card) {
                var caixa = card.getBoundingClientRect();
                var deslocamento = y - caixa.top - caixa.height / 2;

                if (deslocamento < 0 && deslocamento > maisProximo.deslocamento) {
                    return { deslocamento: deslocamento, elemento: card };
                }
                return maisProximo;
            },
            { deslocamento: Number.NEGATIVE_INFINITY, elemento: null },
        ).elemento;
    }

    // --- Abrir modal em modo "Adicionar" ---
    function abrirModalAdicionar() {
        inputId.value = "";
        inputTitulo.value = "";
        inputTitulo.classList.remove("is-invalid");
        selectPrioridade.value = "media";
        selectColuna.value = "todo";
        modalTitulo.textContent = "Nova Tarefa";
        btnSalvar.textContent = "Adicionar";
    }

    document.querySelector('[data-bs-target="#modalNovaTarefa"]').addEventListener("click", abrirModalAdicionar);

    // --- Abrir modal em modo "Editar" (pré-preenchido) ---
    function abrirModalEditar(card) {
        var titulo = card.querySelector(".card-title").textContent;

        inputId.value = card.dataset.id;
        inputTitulo.value = titulo;
        inputTitulo.classList.remove("is-invalid");
        selectPrioridade.value = card.dataset.priority;
        selectColuna.value = card.closest(".kanban-list").dataset.status;
        modalTitulo.textContent = "Editar Tarefa";
        btnSalvar.textContent = "Salvar Alterações";

        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    // --- Excluir card ---
    function excluirCard(card) {
        var titulo = card.querySelector(".card-title").textContent;

        if (!confirm('Excluir a tarefa "' + titulo + '"?')) {
            return;
        }

        card.remove();
        atualizarContadores();

        // Ponto de integração com o backend ASP:
        // fetch('/excluir-tarefa.asp?id=' + encodeURIComponent(card.dataset.id), { method: 'POST' });
    }

    // --- Delegação de eventos: editar/excluir funcionam em cards criados dinamicamente também ---
    board.addEventListener("click", function (e) {
        var btnEditar = e.target.closest('[data-action="editar"]');
        var btnExcluir = e.target.closest('[data-action="excluir"]');

        if (btnEditar) {
            abrirModalEditar(btnEditar.closest(".kanban-card"));
        } else if (btnExcluir) {
            excluirCard(btnExcluir.closest(".kanban-card"));
        }
    });

    // --- Salvar (funciona tanto pra criar quanto pra editar) ---
    btnSalvar.addEventListener("click", function () {
        var titulo = inputTitulo.value.trim();
        var prioridade = selectPrioridade.value;
        var colunaSelecionada = selectColuna.value;
        var idEmEdicao = inputId.value;

        if (!titulo) {
            inputTitulo.classList.add("is-invalid");
            inputTitulo.focus();
            return;
        }

        if (idEmEdicao) {
            // Modo edição: atualiza o card existente em vez de criar um novo
            var cardExistente = board.querySelector('.kanban-card[data-id="' + idEmEdicao + '"]');

            cardExistente.className = "kanban-card priority-" + prioridade;
            cardExistente.dataset.priority = prioridade;
            cardExistente.innerHTML = montarHtmlCard(titulo, prioridade, idEmEdicao);
            cardExistente.querySelector(".card-title").textContent = titulo;
            ligarEventosCard(cardExistente);

            var listaDestino = board.querySelector('.kanban-list[data-status="' + colunaSelecionada + '"]');
            listaDestino.appendChild(cardExistente);

            // fetch('/editar-tarefa.asp', { method: 'POST', body: '...' });
        } else {
            // Modo criação
            contadorId++;
            var novoCard = criarCardElemento(titulo, prioridade, contadorId);
            var listaDestinoNova = board.querySelector('.kanban-list[data-status="' + colunaSelecionada + '"]');
            listaDestinoNova.appendChild(novoCard);

            // fetch('/salvar-tarefa.asp', { method: 'POST', body: '...' });
        }

        atualizarContadores();

        inputTitulo.value = "";
        inputTitulo.classList.remove("is-invalid");
        bootstrap.Modal.getInstance(modalEl).hide();
    });

    inputTitulo.addEventListener("input", function () {
        this.classList.remove("is-invalid");
    });

    atualizarContadores();
})();
</script>
